{
  "expo": {
    "name": "PurplePartner",
    "slug": "purple-squad-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "purplepartner",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.purplesquad.partner",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "in.purplesquad.partner",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#4D029B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CALL_PHONE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4D029B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6527B8",
          "defaultChannel": "jobs"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PurplePartner uses your photos to attach job completion proof and KYC documents.",
          "cameraPermission": "PurplePartner uses the camera to photograph completed work, receipts and KYC documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PurplePartner uses your location to dispatch nearby jobs and confirm arrival at customer sites.",
          "locationAlwaysAndWhenInUsePermission": "PurplePartner uses your location in the background so you keep receiving nearby jobs and customers can see your arrival status.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
