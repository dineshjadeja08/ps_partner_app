# Public runtime configuration. Never place server secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Partner endpoints that the backend does not ship yet (wallet, earnings, performance, reviews,
# leaves, restrictions, ID card) are served from src/lib/mock-data.ts while this is "true".
# Set to "false" once those endpoints exist; see docs/PARTNER_API_CONTRACT.md.
EXPO_PUBLIC_PARTNER_MOCKS=true
